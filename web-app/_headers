/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://cdn.tailwindcss.com; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'

/libs/mediapipe/*.mjs
  Content-Type: text/javascript
  Cache-Control: public, max-age=31536000, immutable

/libs/mediapipe/wasm_v2/*.js
  Content-Type: text/javascript
  Cache-Control: public, max-age=0, must-revalidate

/libs/mediapipe/wasm_v2/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=0, must-revalidate

/libs/mediapipe/models/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=0, must-revalidate